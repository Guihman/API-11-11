{
  "name": "backend-base-em",
  "version": "1.0.0",
  "description": "API RESTful em n-camadas com Node.js, Express, PostgreSQL e Sequelize para leituras ambientais.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "import:csv": "node src/scripts/importCsv.js",
    "import:csv:clear": "node src/scripts/importCsv.js --clear",
    "reset:leituras": "node src/scripts/resetLeituras.js",
    "test:api": "node src/scripts/testApiAxios.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "sequelize",
    "api-rest",
    "n-camadas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
