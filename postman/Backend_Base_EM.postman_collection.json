    {
      "name": "07 - Criar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leituras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leituras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"station_id\": \"EM-POSTMAN-01\",\n  \"timestamp\": \"2026-11-11T08:00:00-03:00\",\n  \"temperature_c\": 25.5,\n  \"humidity_pct\": 62.3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"POST criou uma leitura\", function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.id).to.be.a(\"number\");",
              "});",
              "const novoId = pm.response.json().data.id;",
              "pm.environment.set(\"id_leitura\", novoId);"
            ]
          }
        }
      ]
    },
